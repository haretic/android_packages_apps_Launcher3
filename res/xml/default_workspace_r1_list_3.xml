<favorites xmlns:launcher="http://schemas.android.com/apk/res-auto/com.android.launcher3">
    <appwidget launcher:packageName="com.android.deskclock"
        launcher:className="com.android.alarmclock.DigitalAppWidgetProvider"
        launcher:screen="0" launcher:x="0" launcher:y="0"
        launcher:spanX="3" launcher:spanY="1" />
    <resolve launcher:screen="0" launcher:x="0" launcher:y="1">
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_GALLERY;end" />
    </resolve>
    <resolve launcher:screen="0" launcher:x="1" launcher:y="1">
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_MUSIC;end" />
    </resolve>
    <resolve launcher:screen="0" launcher:x="2" launcher:y="1">
        <favorite launcher:uri="#Intent;action=android.settings.SETTINGS;end" />
    </resolve>
    <resolve launcher:screen="0" launcher:x="0" launcher:y="2">
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_BROWSER;end" />
    </resolve>
    <resolve launcher:screen="0" launcher:x="1" launcher:y="2">
        <favorite launcher:uri="#Intent;action=android.intent.action.VIEW;type=vnd.android.document/directory;end" />
    </resolve>
    <resolve launcher:screen="0" launcher:x="2" launcher:y="2">
        <favorite launcher:uri="#Intent;action=android.intent.action.SHOW_ALARMS;end" />
    </resolve>
    <resolve launcher:container="-101" launcher:screen="0" launcher:x="0" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.intent.action.DIAL;end" />
    </resolve>
    <resolve launcher:container="-101" launcher:screen="1" launcher:x="1" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.intent.action.MAIN;category=android.intent.category.APP_MESSAGING;end" />
    </resolve>
    <resolve launcher:container="-101" launcher:screen="2" launcher:x="2" launcher:y="0">
        <favorite launcher:uri="#Intent;action=android.media.action.STILL_IMAGE_CAMERA;end" />
    </resolve>
</favorites>
