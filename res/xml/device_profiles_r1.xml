<profiles xmlns:launcher="http://schemas.android.com/apk/res-auto">
    <grid-option launcher:name="r1_list_1"
        launcher:numRows="4" launcher:numColumns="1"
        launcher:numAllAppsColumns="1" launcher:numFolderRows="4"
        launcher:numFolderColumns="1" launcher:numHotseatIcons="1"
        launcher:numExtendedHotseatIcons="1"
        launcher:dbFile="launcher_r1_list_1.db"
        launcher:defaultLayoutId="@xml/default_workspace_r1_list_1"
        launcher:deviceCategory="phone">
        <!-- All apps is a list here, an icon beside its name a row: list rows, not tiles -->
        <display-option launcher:name="Rabbit R1 list 1"
            launcher:minWidthDps="413" launcher:minHeightDps="526"
            launcher:iconImageSize="56" launcher:iconTextSize="16"
            launcher:allAppsIconSize="48" launcher:allAppsIconTextSize="16"
            launcher:allAppsBorderSpace="4" launcher:allAppsCellHeight="64"
            launcher:hotseatBarBottomSpace="12" launcher:canBeDefault="true" />
    </grid-option>
    <grid-option launcher:name="r1_list_2"
        launcher:numRows="4" launcher:numColumns="2"
        launcher:numAllAppsColumns="2" launcher:numFolderRows="4"
        launcher:numFolderColumns="2" launcher:numHotseatIcons="2"
        launcher:numExtendedHotseatIcons="2"
        launcher:dbFile="launcher_r1_list_2.db"
        launcher:defaultLayoutId="@xml/default_workspace_r1_list_2"
        launcher:deviceCategory="phone">
        <display-option launcher:name="Rabbit R1 list 2"
            launcher:minWidthDps="413" launcher:minHeightDps="526"
            launcher:iconImageSize="56" launcher:iconTextSize="16"
            launcher:allAppsIconSize="56" launcher:allAppsIconTextSize="16"
            launcher:allAppsBorderSpace="12" launcher:allAppsCellHeight="88"
            launcher:hotseatBarBottomSpace="12" launcher:canBeDefault="true" />
    </grid-option>
    <grid-option launcher:name="r1_list_3"
        launcher:numRows="3" launcher:numColumns="3"
        launcher:numAllAppsColumns="3" launcher:numFolderRows="4"
        launcher:numFolderColumns="3" launcher:numHotseatIcons="3"
        launcher:numExtendedHotseatIcons="3"
        launcher:dbFile="launcher_r1_list_3.db"
        launcher:defaultLayoutId="@xml/default_workspace_r1_list_3"
        launcher:deviceCategory="phone">
        <display-option launcher:name="Rabbit R1 list 3"
            launcher:minWidthDps="413" launcher:minHeightDps="526"
            launcher:iconImageSize="56" launcher:iconTextSize="16"
            launcher:allAppsIconSize="56" launcher:allAppsIconTextSize="16"
            launcher:allAppsBorderSpace="12" launcher:allAppsCellHeight="88"
            launcher:hotseatBarBottomSpace="12" launcher:canBeDefault="true" />
    </grid-option>
</profiles>
